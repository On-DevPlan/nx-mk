{
  "name": "mk",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI-driven frontend API/UI coverage analyzer with SDK Facade",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsup": "^8.0.2",
    "vitest": "^1.0.4",
    "tsx": "^4.7.0"
  },
  "packageManager": "pnpm@9.0.0"
}