{
  "name": "nx-mk",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI-driven frontend API/UI coverage analyzer with SDK Facade",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @nx-mk-example/server dev",
    "dev:app": "pnpm --filter @nx-mk-example/app dev",
    "demo:openapi": "pnpm --filter @nx-mk-example/server openapi",
    "demo:codegen": "pnpm --filter @nx-mk-example/server openapi && pnpm --filter @nx-mk/client build && pnpm exec tsx examples/react-vite-demo/generate-sdk.ts",
    "demo:typecheck": "pnpm --filter @nx-mk-example/app typecheck && pnpm --filter @nx-mk-example/server typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "tsup": "^8.0.2",
    "vitest": "^1.0.4",
    "tsx": "^4.7.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.27.0"
    }
  },
  "packageManager": "pnpm@9.0.0"
}