{
  "name": "@nx-mk/agent",
  "version": "0.1.0",
  "private": true,
  "description": "nx-mk agent-sdk — coverage-gap Agent Loop (suggest-diff, claude-code provider)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
