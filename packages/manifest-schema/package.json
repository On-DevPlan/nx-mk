{
  "name": "@nx-mk/manifest-schema",
  "version": "0.1.0",
  "private": true,
  "description": "nx-mk Manifest Definition: shared types + schema utilities (M4 split)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsup": "^8.0.2",
    "vitest": "^1.0.4",
    "@types/node": "^20.10.0"
  }
}
