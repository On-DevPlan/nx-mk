{
  "name": "@mk/kernel",
  "version": "0.1.0",
  "description": "mk microkernel — plugin system, event bus, lifecycle",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder'",
    "clean": "rm -rf dist .turbo node_modules .tsbuildinfo"
  },
  "dependencies": {
    "@mk/manifest": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}